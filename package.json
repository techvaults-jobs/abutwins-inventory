{
  "name": "abutwins-nexus",
  "version": "1.0.0",
  "description": "Abu Twins Softskills multi-shop system for phones, laptops, and power.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "setup": "prisma generate && prisma db push && prisma db seed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-users": "tsx prisma/seed-users.ts",
    "db:seed-demo": "tsx prisma/seed-demo-ibadan.ts",
    "check:concurrency": "tsx scripts/check-concurrency.ts",
    "check:day-closes": "tsx scripts/check-day-closes.ts",
    "check:branches": "tsx scripts/check-branch-isolation.ts",
    "staff:plan": "tsx scripts/provision-staff.ts",
    "staff:apply": "tsx scripts/provision-staff.ts --apply",
    "shops:remove-plan": "tsx scripts/remove-retired-shops.ts",
    "shops:remove-apply": "tsx scripts/remove-retired-shops.ts --apply",
    "check:uploads": "tsx scripts/check-uploads.ts",
    "check:payables": "tsx scripts/check-payables.ts",
    "check:totals": "tsx scripts/check-totals.ts",
    "check:money-in": "tsx scripts/check-money-in.ts",
    "check:actions": "tsx scripts/check-server-actions.ts",
    "check:all": "npm run check:actions && npm run check:concurrency && npm run check:branches && npm run check:day-closes && npm run check:payables && npm run check:uploads && npm run check:totals && npm run check:money-in",
    "deploy:build": "node scripts/use-postgres-schema.mjs && prisma generate && next build",
    "deploy:start": "node scripts/use-postgres-schema.mjs && prisma generate && tsx scripts/heal-day-closes.ts && prisma db push --accept-data-loss && tsx prisma/seed-users.ts && next start",
    "data:purge-demo": "tsx scripts/purge-demo-data.ts",
    "staff:owner": "tsx scripts/create-owner.ts",
    "staff:seed": "tsx scripts/create-staff.ts",
    "staff:local": "tsx scripts/seed-local-logins.ts",
    "stock:opening": "tsx scripts/import-opening-stock.ts",
    "stock:heal-imei": "tsx scripts/heal-imei-shelf.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "nextConfig": "next.config.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belloibrahv/abutwins-invent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/belloibrahv/abutwins-invent/issues"
  },
  "homepage": "https://github.com/belloibrahv/abutwins-invent#readme",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@serwist/turbopack": "^9.5.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "docx": "^9.7.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "framer-motion": "^13.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.41.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "prisma": "^6.16.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "serwist": "^9.5.12",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  }
}
