generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CEO
  AUDITOR
  ACCOUNTANT
  BRANCH_MANAGER
  VAULT_MANAGER
  STOCK_UPLOADER
  CASHIER
  SALES_EXECUTIVE
  ENGINEER
}

enum ProductCondition {
  BRAND_NEW
  BRAND_NEW_LOCKED
  BRAND_NEW_NA
  OPEN_BOX
  UK_USED
  UK_LOCKED
  STANDARD
  REFURBISHED
  SWAP_DEVICE
  FAULTY
  REPAIR_DEVICE
}

enum IMEIStatus {
  RECEIVED
  INCOMING
  IN_STOCK
  TRANSFERRED
  SOLD
  RETURNED
  REPAIRED
  SWAPPED
  DISPOSED
  FAULTY
  RETURNED_TO_SUPPLIER
}

enum ProductTracking {
  IMEI
  SERIAL
  NONE
}

enum OpeningStockStatus {
  OPEN
  CLOSED
}

enum IncomingStatus {
  COMING
  PENDING_APPROVAL
  ARRIVED
  CANCELLED
}

enum IncomingIdentity {
  IMEI
  SERIAL
  NONE
}

enum PurchaseStatus {
  PENDING
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  CREDIT
  SPLIT_PAYMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum LedgerEntryType {
  SALE
  PAYMENT
  REFUND
  ADJUSTMENT
  DISCOUNT
  CREDIT_NOTE
}

enum ReturnReason {
  FAULTY
  WARRANTY
  CUSTOMER_DISSATISFACTION
  DAMAGED
  SUPPLIER_RETURN
  WRONG_PRODUCT
  /// The customer wants another item instead (a replacement).
  EXCHANGE
}

enum ReturnOutcome {
  REPLACEMENT
  REPAIR
  REFUND
  CREDIT_NOTE
  SEND_TO_SUPPLIER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum FaultClass {
  GOOD_STOCK
  FAULTY_STOCK
  REPAIR_STOCK
  SCRAP_STOCK
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RepairStatus {
  PENDING
  DIAGNOSING
  REPAIRING
  WAITING_PARTS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SupplierKind {
  SUPPLIER
  NEIGHBOR
}

enum ExpenseCategory {
  TRANSPORT
  FUEL
  RENT
  UTILITIES
  REPAIRS
  SALARY
  MISCELLANEOUS
  MARKETING
}

enum ApprovalType {
  PRICE_DISCOUNT
  REFUND
  STOCK_ADJUSTMENT
  RECONCILIATION
  EXPENSE
  TRANSFER
  SWAP
  RETURN
  INCOMING_RECEIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReconciliationStatus {
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  IMPORT
  DENIED
  VIEW
}

enum NotificationType {
  LOW_STOCK
  PRICE_UPDATE
  APPROVAL_REQUEST
  PRICE_REQUEST
  DUE_PAYMENT
  TRANSFER
  RETURN
  SYSTEM
}

/**
 * A seller asking the CEO or the main admin to let a sale go under the lowest
 * allowed price, or under cost. Decided in the app; see price-requests.ts.
 */
enum PriceRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
  USED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  password           String
  role               UserRole  @default(SALES_EXECUTIVE)
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  isActive           Boolean   @default(true)
  twoFactorEnabled   Boolean   @default(false)
  totpSecret         String?
  mustChangePassword Boolean   @default(false)
  /// Sessions signed in before this moment are refused. Set when the password
  /// is changed or reset, so a stolen session ends with the old password.
  sessionsValidAfter DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs       AuditLog[]
  sales           Sale[]
  purchases       Purchase[]
  expenses        Expense[]
  notifications   Notification[]
  transfers       StockTransfer[]
  transfersReceived StockTransfer[] @relation("TransferReceiver")
  swaps           Swap[]
  repairs         Repair[]
  returns         StockReturn[]
  approvalsReq    Approval[]       @relation("ApprovalRequester")
  approvalsDec    Approval[]       @relation("ApprovalDecider")
  priceRequests   PriceRequest[]   @relation("PriceRequestSeller")
  priceDecisions  PriceRequest[]   @relation("PriceRequestDecider")
  reconciliations Reconciliation[]
  incomingLots    IncomingLot[]
  dayCloses       DayClose[]
  parkedSales     ParkedSale[]
  stockMoves      StockMovement[]
  cashDeposits    CashDeposit[]
  supplierReturnLines SupplierReturnLine[]

  @@index([email])
  @@index([branchId])
  @@index([role])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  isHq      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  inventory       Inventory[]
  sales           Sale[]
  purchases       Purchase[]
  expenses        Expense[]
  transfersOut    StockTransfer[]  @relation("TransferFrom")
  transfersIn     StockTransfer[]  @relation("TransferTo")
  reconciliations Reconciliation[]
  customers       Customer[]
  imeiRecords     ImeiRecord[]
  swaps           Swap[]
  returns         StockReturn[]
  repairs         Repair[]
  financeEntries  FinanceEntry[]
  incomingLots    IncomingLot[]
  dayCloses       DayClose[]
  parkedSales     ParkedSale[]
  stockMoves      StockMovement[]
  openingStock    OpeningStock?
  bankAccounts    BankAccount[]
  priceRequests   PriceRequest[]
  cashDeposits    CashDeposit[]
  /// Cash in the till on the day this shop started using the software.
  openingCash     Decimal    @default(0)
  openingCashAt   DateTime?
  openingCashBy   String?
  supplierReturnLines SupplierReturnLine[]

  @@index([code])
  @@index([isActive])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  /// Reseller markup over cost, as a percentage. 12 means resellers are quoted
  /// cost + 12%. The quote follows cost, so one rate change moves every item in
  /// the category instead of hundreds of typed prices.
  resellerMarkup Decimal @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String           @id @default(cuid())
  sku          String           @unique
  name         String
  description  String?
  brandId      String
  brand        Brand            @relation(fields: [brandId], references: [id])
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  condition    ProductCondition
  color        String?
  storage      String?
  ram          String?
  costPrice    Decimal
  minimumPrice Decimal
  sellingPrice Decimal
  marketPrice  Decimal?
  warrantyDays Int              @default(0)
  tracking     ProductTracking  @default(IMEI)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  inventory     Inventory[]
  imeiRecords   ImeiRecord[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  priceHistory  PriceHistory[]
  transferItems TransferItem[]
  swaps         Swap[]
  reconItems    ReconciliationItem[]
  incomingItems IncomingItem[]
  stockMoves    StockMovement[]
  supplierReturnLines SupplierReturnLine[]

  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([condition])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Decimal
  newPrice  Decimal
  priceType String
  reason    String?
  changedBy String
  changedAt DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

model ImeiRecord {
  id             String     @id @default(cuid())
  imei1          String     @unique
  imei2          String?
  serialNumber   String?
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?  @relation(fields: [supplierId], references: [id])
  branchId       String
  branch         Branch     @relation(fields: [branchId], references: [id])
  status         IMEIStatus @default(RECEIVED)
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  saleId         String?
  sale           Sale?      @relation(fields: [saleId], references: [id])
  purchaseId     String?
  purchase       Purchase?  @relation(fields: [purchaseId], references: [id])
  notes          String?
  cosmeticGrade  String?
  batteryHealth  Int?
  conditionNotes String?
  photoData      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  saleItems     SaleItem[]
  returns       StockReturn[]             @relation("ReturnOld")
  returnReplacements StockReturn[]        @relation("ReturnReplacement")
  repairs       Repair[]
  swapsOld      Swap[]         @relation("SwapOld")
  swapsNew      Swap[]         @relation("SwapNew")
  supplierReturnLines SupplierReturnLine[]

  @@index([imei1])
  @@index([imei2])
  @@index([serialNumber])
  @@index([productId])
  @@index([branchId])
  @@index([status])
  @@index([purchaseId])
  @@index([branchId, status])
  @@index([status, productId])
}

/**
 * Why stock moved. The shop reads these words back on the item's history, so
 * they name the event, not the table it came from.
 */
enum StockMoveKind {
  OPENING
  RECEIVED
  SALE
  SALE_REVERSED
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_IN
  REPLACEMENT_OUT
  RETURN_TO_SUPPLIER
  SWAP_OUT
  SWAP_IN
  REPAIR_OUT
  REPAIR_IN
  COUNT_ADJUST
  HAND_CORRECTION
}

/**
 * One row per change to what is on a shelf. Before this, the shelf held only
 * its current figure, so a question as ordinary as "what did this shop open
 * with today" had to be worked backwards from whatever papers happened to carry
 * a date — and any correction made by hand left no trace at all.
 *
 * Written inside the same transaction as the shelf move itself, so the ledger
 * cannot drift from the quantity it explains.
 */
model StockMovement {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  /// Signed: positive onto the shelf, negative off it.
  quantity  Int
  kind      StockMoveKind
  /// The paper this move came from — invoice, transfer, or supplier bill number.
  reference String?
  /// Who did it. Null for a move the system made on its own.
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  /// Shop business day in West Africa Time, so a day groups without date maths.
  businessDate String
  createdAt DateTime      @default(now())

  @@index([branchId, businessDate])
  @@index([productId, branchId])
  @@index([businessDate])
  @@index([createdAt])
}

model Inventory {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity       Int       @default(0)
  incomingQty    Int       @default(0)
  reserved       Int       @default(0)
  minStock       Int       @default(3)
  lastStockCheck DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
}

model Supplier {
  id            String       @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String
  address       String?
  country       String?
  city          String?
  kind          SupplierKind @default(SUPPLIER)
  isActive      Boolean      @default(true)
  /// Surplus after send-backs that were not on a supplier bill, so this house owes us.
  creditBalance Decimal      @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  purchases     Purchase[]
  imeiRecords   ImeiRecord[]
  incomingLots  IncomingLot[]
  stockReturns  StockReturn[]
  supplierReturnLines SupplierReturnLine[]

  @@index([isActive])
  @@index([kind])
}

model Purchase {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  status        PurchaseStatus @default(PENDING)
  totalAmount   Decimal
  paidAmount    Decimal        @default(0)
  /// Cost of units sent back to this supplier. Cuts what we still owe, or
  /// leaves a surplus when we already paid.
  returnedAmount Decimal       @default(0)
  paymentMethod String?
  notes         String?
  /// UPLOAD_STOCK when the bill was born on Upload stock (manual session or Excel).
  source        String?
  /// True while the stock uploader is still adding units to this bill by hand.
  sessionOpen   Boolean        @default(false)
  originCountry String?
  originCity    String?
  expectedDate  DateTime?
  receivedDate  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items        PurchaseItem[]
  incomingLots IncomingLot[]
  imeiRecords  ImeiRecord[]
  openingStock OpeningStock?
  supplierReturnLines SupplierReturnLine[]

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([source])
  @@index([sessionOpen])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  costPrice   Decimal
  totalAmount Decimal
  receivedQty Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([purchaseId])
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  saleType      String        @default("RETAIL")
  status        SaleStatus    @default(PENDING)
  subtotal      Decimal
  discount      Decimal       @default(0)
  tax           Decimal       @default(0)
  totalAmount   Decimal
  paidAmount    Decimal       @default(0)
  paymentMethod PaymentMethod
  paymentNotes  String?
  notes         String?
  /// Why money was taken off the whole order. Staff must give it when the
  /// discount takes the sale under what the stock may be sold for.
  discountReason String?
  /// Who let this sale go under the lowest allowed price or under cost, when
  /// the seller could not. The CEO or Super Admin signs it off on the till with
  /// their own password. Name is copied in so the record reads the same later.
  priceApprovedById String?
  priceApprovedBy   String?
  isWholesale   Boolean       @default(false)
  saleDate      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         SaleItem[]
  payments      Payment[]
  imeis         ImeiRecord[]

  @@index([invoiceNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([saleDate])
  @@index([branchId, status, saleDate])
  @@index([customerId, status])
}

model SaleItem {
  id         String      @id @default(cuid())
  saleId     String
  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  imeiId     String?
  imei       ImeiRecord? @relation(fields: [imeiId], references: [id])
  quantity   Int
  unitPrice  Decimal
  discount   Decimal     @default(0)
  totalPrice Decimal
  /// What this unit cost us on the day it was sold, copied in at checkout.
  /// Profit used to be read from the product's current cost, so a later batch
  /// landing at a new exchange rate silently rewrote the profit on sales
  /// already made. 0 marks a row written before this field existed.
  costPrice  Decimal     @default(0)
  /// The standard price the till offered before anyone typed over it. Kept so
  /// a discount can be seen for what it was long after the price list moved on.
  listPrice  Decimal     @default(0)
  /// Why this price left the standard one. Staff must give it when a sale goes
  /// under the lowest allowed price or under cost.
  priceReason String?
  warrantyDays Int?      @default(0)
  createdAt  DateTime    @default(now())

  stockReturns StockReturn[] @relation("ReturnSaleItem")

  @@index([saleId])
  @@index([imeiId])
}

model Payment {
  id            String        @id @default(cuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Decimal
  method        PaymentMethod
  /// Named bank when money came in by bank (transfer or POS terminal). Cash leaves this empty.
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())

  @@index([saleId])
  @@index([paidAt])
  @@index([bankAccountId])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  email          String?
  address        String?
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  notes          String?
  creditLimit    Decimal  @default(0)
  currentBalance Decimal  @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales         Sale[]
  imeiRecords   ImeiRecord[]
  ledgerEntries LedgerEntry[]
  returns       StockReturn[]
  swaps         Swap[]
  repairs       Repair[]

  @@index([phone])
  @@index([branchId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amount      Decimal
  balance     Decimal
  reference   String?
  description String?
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model StockReturn {
  id               String        @id @default(cuid())
  returnNumber     String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  saleId           String?
  /// For returns on non-IMEI items (accessories, cords, pieces). Points to the
  /// exact SaleItem line the customer is returning. Null for IMEI-based returns.
  saleItemId       String?
  saleItem         SaleItem?     @relation("ReturnSaleItem", fields: [saleItemId], references: [id])
  imeiId           String?
  imei             ImeiRecord?   @relation("ReturnOld", fields: [imeiId], references: [id])
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  reason           ReturnReason
  outcome          ReturnOutcome
  faultClass       FaultClass    @default(FAULTY_STOCK)
  status           ReturnStatus  @default(PENDING)
  /// What the returned item is worth (from the original sale line when known).
  returnValue      Decimal?
  /// Kept in sync with returnValue for refund / credit paths.
  refundAmount     Decimal?
  replacementImeiId String?
  replacementImei  ImeiRecord?   @relation("ReturnReplacement", fields: [replacementImeiId], references: [id])
  /// What the shop item given out is worth on a Replace outcome.
  replacementValue Decimal?
  /// replacementValue minus returnValue. Positive = Receivable. Negative = Payable.
  balanceAmount    Decimal?
  notes            String?
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  sentToSupplierAt DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([returnNumber])
  @@index([branchId])
  @@index([status])
  @@index([supplierId])
  @@index([replacementImeiId])
  @@index([saleItemId])
}

model Swap {
  id                 String           @id @default(cuid())
  swapNumber         String           @unique
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id])
  oldImeiId          String
  oldImei            ImeiRecord       @relation("SwapOld", fields: [oldImeiId], references: [id])
  oldDeviceCondition ProductCondition
  tradeValue         Decimal
  newProductId       String
  newProduct         Product          @relation(fields: [newProductId], references: [id])
  newProductPrice    Decimal
  newImeiId          String?
  newImei            ImeiRecord?      @relation("SwapNew", fields: [newImeiId], references: [id])
  balanceAmount      Decimal
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  status             SwapStatus       @default(PENDING)
  notes              String?
  approvedBy         String?
  approvedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([swapNumber])
  @@index([branchId])
  @@index([status])
}

model Repair {
  id                  String       @id @default(cuid())
  repairNumber        String       @unique
  imeiId              String
  imei                ImeiRecord   @relation(fields: [imeiId], references: [id])
  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id])
  branchId            String
  branch              Branch       @relation(fields: [branchId], references: [id])
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  issue               String
  diagnosis           String?
  repairCost          Decimal?
  status              RepairStatus @default(PENDING)
  estimatedCompletion DateTime?
  completedAt         DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([repairNumber])
  @@index([branchId])
  @@index([status])
}

model StockTransfer {
  id             String         @id @default(cuid())
  transferNumber String         @unique
  fromBranchId   String
  fromBranch     Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId     String
  toBranch       Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  /// Who decided the transfer at the receiving shop: accepted it (RECEIVED)
  /// or rejected it (CANCELLED). Empty while it waits.
  receivedByUserId String?
  receivedByUser   User?        @relation("TransferReceiver", fields: [receivedByUserId], references: [id])
  notes          String?
  status         TransferStatus @default(PENDING)
  sentAt         DateTime?
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items TransferItem[]

  @@index([transferNumber])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model TransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Int
  receivedQty Int           @default(0)
  createdAt   DateTime      @default(now())

  @@index([transferId])
}

model Expense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  category      ExpenseCategory
  amount        Decimal
  description   String
  date          DateTime        @default(now())
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([expenseNumber])
  @@index([branchId])
  @@index([category])
}

model FinanceEntry {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  account     String
  type        String
  amount      Decimal
  reference   String?
  description String?
  /// The named bank the money moved through, when it went by bank (refunds).
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId])
  @@index([createdAt])
  @@index([bankAccountId])
}

/// A named bank or wallet. Opening balance is money already in that account
/// when the shops started using this software. Bank sales on Sell now land on
/// a named account. Cash stays in the till.
model BankAccount {
  id             String    @id @default(cuid())
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id])
  bankName       String
  accountNumber  String
  accountName    String?
  openingBalance Decimal   @default(0)
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
  cashDeposits   CashDeposit[]
  financeEntries FinanceEntry[]

  @@index([branchId])
  @@index([accountNumber])
  @@index([isActive])
}

/// Cash taken out of a shop's till and paid into one of our bank accounts.
/// Our money only changes place: it leaves Cash in the till and lands on the
/// named bank, so it is never an expense, a sale, or profit. An undone deposit
/// keeps its row (undoneAt set) so the record of what happened stays.
model CashDeposit {
  id            String      @id @default(cuid())
  depositNumber String      @unique
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  amount        Decimal
  /// The bank teller slip or transfer reference.
  slipNumber    String?
  note          String?
  depositedAt   DateTime    @default(now())
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  undoneAt      DateTime?
  undoneById    String?
  undoneReason  String?

  @@index([branchId])
  @@index([bankAccountId])
  @@index([depositedAt])
}

/// One unit sent back to a supplier (a return outward). Written by Send back
/// to supplier (reference RTV-…) and by a customer return applied as "Send
/// back to the supplier" (reference RTN-…), so Reports can show what went
/// back, to whom, from which shop, and its value.
model SupplierReturnLine {
  id          String     @id @default(cuid())
  /// The send-back number: RTV-… or the customer return's RTN-….
  reference   String
  supplierId  String
  supplier    Supplier   @relation(fields: [supplierId], references: [id])
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id])
  imeiId      String
  imei        ImeiRecord @relation(fields: [imeiId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  purchaseId  String?
  purchase    Purchase?  @relation(fields: [purchaseId], references: [id])
  /// What the unit cost us: the value going back.
  cost        Decimal
  /// What it did to the money: bill (off the supplier bill), house-credit
  /// (credit with the supplier), opening-stock, no-supplier or no-cost.
  moneyEffect String
  /// SEND_BACK or CUSTOMER_RETURN.
  source      String
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  sentAt      DateTime   @default(now())

  @@unique([reference, imeiId])
  @@index([sentAt])
  @@index([supplierId])
  @@index([branchId])
}

model Approval {
  id          String         @id @default(cuid())
  type        ApprovalType
  entityId    String
  entityType  String
  requestedBy String
  requester   User           @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  requestedAt DateTime       @default(now())
  approvedBy  String?
  decider     User?          @relation("ApprovalDecider", fields: [approvedBy], references: [id])
  approvedAt  DateTime?
  status      ApprovalStatus @default(PENDING)
  reason      String?
  notes       String?

  @@index([type])
  @@index([status])
}

model Reconciliation {
  id            String               @id @default(cuid())
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id])
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  startDate     DateTime
  endDate       DateTime
  status        ReconciliationStatus @default(IN_PROGRESS)
  totalExpected Decimal
  totalCounted  Decimal
  variance      Decimal
  notes         String?
  approvedBy    String?
  approvedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  items ReconciliationItem[]

  @@index([branchId])
  @@index([status])
}

model ReconciliationItem {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  expectedQty      Int
  countedQty       Int
  variance         Int
  varianceValue    Decimal
  reason           String?
  createdAt        DateTime       @default(now())

  @@index([reconciliationId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  path       String?
  success    Boolean     @default(true)
  risk       String      @default("LOW")
  hash       String?
  branchId   String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([risk])
  @@index([success])
  @@index([createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  status    NotificationStatus @default(UNREAD)
  actionUrl String?
  createdAt DateTime           @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model IncomingLot {
  id           String         @id @default(cuid())
  lotNumber    String         @unique
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id])
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  status       IncomingStatus @default(COMING)
  visible      Boolean        @default(false)
  expectedDate DateTime?
  notes        String?
  purchaseId   String?
  purchase     Purchase?      @relation(fields: [purchaseId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        IncomingItem[]

  @@index([branchId])
  @@index([status])
  @@index([purchaseId])
}

model DayClose {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  closeDate     DateTime
  businessDate  String   @default("")
  expectedCash  Decimal
  countedCash   Decimal
  variance      Decimal
  transferTotal Decimal  @default(0)
  posTotal      Decimal  @default(0)
  creditTotal   Decimal  @default(0)
  saleCount     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([branchId])
  @@index([closeDate])
  @@index([businessDate])
  @@unique([branchId, businessDate])
}

enum ParkedSaleStatus {
  PARKED
  POSTED
  VANISHED
  FAILED
}

model ParkedSale {
  id           String           @id
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  deviceId     String
  queuedAt     DateTime
  lastSeenAt   DateTime
  status       ParkedSaleStatus @default(PARKED)
  payload      String
  postedSaleId String?
  alertedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([branchId])
  @@index([deviceId])
  @@index([status])
}

model IncomingItem {
  id               String           @id @default(cuid())
  lotId            String
  lot              IncomingLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  /// How many the carton / bill said were coming. Never overwritten on receive.
  expectedQuantity Int              @default(0)
  /// How many actually entered the shop. Null while still Coming / waiting for yes.
  receivedQuantity Int?
  /// Unit cost confirmed on the carton (used when dual-control finalises the receive).
  receivedUnitCost Decimal?
  /// Kept in sync with expectedQuantity (Coming) or receivedQuantity (Arrived)
  /// so older screens that only read quantity stay correct.
  quantity         Int
  identity         IncomingIdentity
  identifiers      String?
  createdAt        DateTime         @default(now())

  @@index([lotId])
  @@index([productId])
}

model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  permKey   String
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, permKey])
  @@index([role])
}

/// What one shop opened the software with. Open while it is corrected against a
/// physical count; Closed once the CEO or main admin says it is final, after
/// which nothing about it can change and the closing figures below are the
/// shop's opening position for financial reporting.
model OpeningStock {
  id             String             @id @default(cuid())
  branchId       String             @unique
  branch         Branch             @relation(fields: [branchId], references: [id])
  /// The opening bill whose lines are the opening quantities and costs.
  purchaseId     String             @unique
  purchase       Purchase           @relation(fields: [purchaseId], references: [id])
  status         OpeningStockStatus @default(OPEN)
  closedAt       DateTime?
  closedBy       String?
  /// Value at cost, units, and item lines on the day it was closed.
  closedValue    Decimal?
  closedQuantity Int?
  closedLines    Int?
  /// JSON copy of every line (code, name, qty, cost, lowest and standard price,
  /// IMEIs) as closed, so later price changes never rewrite the opening.
  snapshot       String?
  /// Set when the CEO or Super Admin opened a closed opening stock again to
  /// fix it (a guessed price from the sheet, say). The last reopen is kept
  /// here; every one is on Who did what.
  reopenedAt     DateTime?
  reopenedBy     String?
  reopenReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

/**
 * One ask from the till: "may I sell this deal at these prices?"
 *
 * The seller sends it instead of the CEO typing a password on their till. The
 * CEO or main admin answers from wherever they are in the app; the first
 * answer decides. On yes, the signed approval for this exact deal is kept here
 * and handed to the seller's till, which sends it with the sale.
 */
model PriceRequest {
  id            String             @id @default(cuid())
  requestNumber String             @unique
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id])
  sellerId      String
  seller        User               @relation("PriceRequestSeller", fields: [sellerId], references: [id])
  status        PriceRequestStatus @default(PENDING)
  /// The deal as the till will send it (JSON ApprovedDeal): what the approval is bound to.
  deal          String
  /// What the approver reads (JSON): lines with names, asked and standard prices, and the sale total.
  summary       String
  total         Decimal
  reason        String?
  customerName  String?
  decidedById   String?
  decidedBy     User?              @relation("PriceRequestDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  /// The signed approval, only ever returned to the seller who asked.
  approvalToken String?
  saleId        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([sellerId, status])
  @@index([branchId, status])
  @@index([createdAt])
}
